# ── Base ──────────────────────────────────────────────────────────────────────────────────────
DATABASE_URL=postgresql://rcv:rcv@localhost:5434/rcv_kiubo
# Los tests de integración TRUNCAN tablas: siempre otra base.
DATABASE_URL_TEST=postgresql://rcv:rcv@localhost:5434/rcv_kiubo_test

PORT=4100

# ── Secretos ──────────────────────────────────────────────────────────────────────────────────
# Llave maestra que sella las llaves privadas de los certificados y los secretos de webhook.
# Formato "<id>:<base64 de 32 bytes>". Para rotar: anteponer una nueva ("2:NUEVA,1:VIEJA").
#   node -e "console.log('1:'+require('crypto').randomBytes(32).toString('base64'))"
# PERDERLA = perder todos los certificados cargados (hay que volver a subirlos).
SELLO_LLAVES=

# Token de la API /admin (alta de consumidores y API keys). Mínimo 32 caracteres.
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
ADMIN_TOKEN=

# Secreto compartido con el Email Worker (x-intercambio-secret). Vacío = entrada de correos apagada.
INTERCAMBIO_SECRET=

# ── SII ───────────────────────────────────────────────────────────────────────────────────────
# Llaves públicas del SII que firman la FRMA de los CAF (PEM, con \n literales). Sin ellas, la
# verificación de un DTE recibido queda "sin_llave" en la prueba del CAF (no falla, no pasa).
# 100 = certificación (maullin) · 300 = producción (palena).
SII_LLAVE_IDK_100=
SII_LLAVE_IDK_300=
SII_CONCURRENCIA=4
SII_TIMEOUT_MS=30000

# ── Operación ─────────────────────────────────────────────────────────────────────────────────
JOBS_ACTIVOS=true
# Sólo desarrollo: permite webhooks a http:// y a localhost.
WEBHOOK_PERMITIR_INSEGURO=false
# Saltos de proxy de confianza (nginx/Cloudflare delante = 1).
TRUST_PROXY=0
LOG_NIVEL=info
